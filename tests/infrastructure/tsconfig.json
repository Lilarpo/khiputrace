{
  "extends": "../../frontend/tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "noEmit": false,
    "outDir": "../../.cache/infrastructure-tests",
    "rootDir": "../..",
    "types": [
      "node"
    ],
    "esModuleInterop": true
  },
  "include": [
    "./*.ts",
